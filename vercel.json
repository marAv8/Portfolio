{
    "rewrites": [
      { "source": "/prototypes", "destination": "/prototypes/index.html" },
      { "source": "/prototypes/", "destination": "/prototypes/index.html" },
      { "source": "/(.*)", "destination": "/" }
    ],
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      }
    ]
  }
  